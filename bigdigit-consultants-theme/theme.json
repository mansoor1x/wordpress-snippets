{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "primary", "name": "Forest Green", "color": "#0b3b2e" },
				{ "slug": "primary-light", "name": "Green", "color": "#145c49" },
				{ "slug": "accent", "name": "Lime", "color": "#c6f25e" },
				{ "slug": "accent-dark", "name": "Lime Dark", "color": "#a9d93a" },
				{ "slug": "ink", "name": "Ink", "color": "#0f1f1a" },
				{ "slug": "body", "name": "Body Text", "color": "#55635e" },
				{ "slug": "muted", "name": "Muted", "color": "#8a9893" },
				{ "slug": "line", "name": "Border", "color": "#e3ebe7" },
				{ "slug": "soft", "name": "Soft Background", "color": "#f3f7f4" },
				{ "slug": "white", "name": "White", "color": "#ffffff" },
				{ "slug": "footer", "name": "Deep Green", "color": "#072a21" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vh", "vw" ]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "jakarta",
					"name": "Plus Jakarta Sans",
					"fontFamily": "\"Plus Jakarta Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.05rem" },
				{ "slug": "large", "name": "Large", "size": "1.25rem" },
				{ "slug": "x-large", "name": "Extra Large", "size": "2.2rem", "fluid": { "min": "1.9rem", "max": "2.8rem" } },
				{ "slug": "xx-large", "name": "Huge", "size": "3.4rem", "fluid": { "min": "2.4rem", "max": "4rem" } }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--body)"
		},
		"spacing": {
			"blockGap": "1.2rem",
			"padding": { "left": "20px", "right": "20px" }
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--jakarta)",
			"fontSize": "16px",
			"lineHeight": "1.7"
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": { "fontWeight": "700", "lineHeight": "1.2", "letterSpacing": "-0.02em" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "fontWeight": "800" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "1.25rem" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--primary-light)" },
				":hover": { "color": { "text": "var(--wp--preset--color--primary)" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": { "radius": "100px" },
				"typography": { "fontWeight": "700", "fontSize": "0.95rem" },
				"spacing": { "padding": { "top": "0.9em", "bottom": "0.9em", "left": "1.6em", "right": "1.6em" } },
				":hover": { "color": { "background": "var(--wp--preset--color--primary-light)" } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-no-title", "title": "Page (No Title)", "postTypes": [ "page" ] }
	]
}
